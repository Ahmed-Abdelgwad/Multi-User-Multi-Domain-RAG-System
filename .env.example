# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=sqlite:///./app.db

# OIDC - internal user pool
OIDC_INTERNAL_DISCOVERY_URL=
OIDC_INTERNAL_CLIENT_ID=
OIDC_INTERNAL_CLIENT_SECRET=

# OIDC - external user pool
OIDC_EXTERNAL_DISCOVERY_URL=
OIDC_EXTERNAL_CLIENT_ID=
OIDC_EXTERNAL_CLIENT_SECRET=

SSO_REDIRECT_BASE_URL=http://localhost:8000
SAML_ENABLED=false

# Comma-separated emails auto-promoted to platform admin on registration/
# first SSO login -- the one-time bootstrap for the very first admin.
# Everyone after that is promoted via PUT /users/{id}/platform-admin.
PLATFORM_ADMIN_EMAILS=

# Section 2: async pipeline (Celery broker/result backend)
REDIS_URL=redis://redis:6379/0

# Section 2: object storage (MinIO / S3-compatible)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# Section 2.4: chunk embedding model -- fixed once for the whole project
# (changing it means re-embedding every existing chunk). See src/config.py
# for why this specific model was picked.
EMBEDDING_MODEL_NAME=ibm-granite/granite-embedding-97m-multilingual-r2

# Section 2.5: how often (seconds) the entity/relation extraction batch
# job sweeps for un-extracted chunks. See src/config.py.
ENTITY_EXTRACTION_BATCH_INTERVAL_SECONDS=300
